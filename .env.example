# Public Supabase connection (subject to RLS). Never expose server secrets.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Hostinger SMTP, SERVER ONLY. Never prefix these with NEXT_PUBLIC_.
SMTP_USER=info@posinventory.store
SMTP_PASSWORD=
REPORT_EMAIL_FROM="POS INVENTORY <reports@posinventory.store>"
INVOICE_EMAIL_FROM="POS INVENTORY <invoice@posinventory.store>"
# Also configure SMTP_USER/SMTP_PASSWORD and sender settings in Supabase secrets.
# INVITATION_EMAIL_FROM=POS INVENTORY <registration@posinventory.store>
# NOTIFICATION_EMAIL_FROM=POS INVENTORY <updates@posinventory.store>
# INVITATION_APP_URL=https://posinventory.shop
# NOTIFICATION_CRON_SECRET=<random server secret, at least 32 characters>
# Supabase Auth SMTP is configured separately; see docs/EMAIL_NOTIFICATIONS.md.
