# Copy to .env.local and fill in. Both values are safe to expose to the browser
# (the anon/publishable key only grants what RLS allows). NEVER put the
# service_role/secret key in this app — every privileged action goes through
# SECURITY DEFINER RPCs executed as the signed-in user.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Optional report email delivery: SERVER ONLY, never NEXT_PUBLIC.
RESEND_API_KEY=
REPORT_EMAIL_FROM=
# Scheduled notification worker configuration is documented in docs/EMAIL_NOTIFICATIONS.md.
